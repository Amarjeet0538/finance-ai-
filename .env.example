# Anthropic API Key for Operator & Classifier
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application endpoints
FINANCE_APP_URL=http://localhost:8000
UI_PORT=8001
FINANCE_PORT=8000

# Auth and session
SESSION_TTL_SECONDS=300

# Deterministic evaluation parameters
POLICY_AS_OF_DATE=2026-10-13
MODEL_NAME=claude-sonnet-4-5
MAX_RUN_COST_USD=2.00

# Fault injection toggles (0 = disabled, 1 = enabled)
INJECT_SESSION_EXPIRY=0
INJECT_VALIDATION_ERROR=0
INJECT_SLOW_PAGE=0
INJECT_TRANSIENT_500=0
